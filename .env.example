# ── ZeroRouter environment ────────────────────────────────────────────────────
# Copy to `.env` (never commit real values). All values optional; defaults below.

# Node environment (production enables stricter defaults)
NODE_ENV=development

# ─ Network exposure ─
# Host to bind. KEEP LOOPBACK (127.0.0.1) unless you have read docs/security.md.
# Binding a non-loopback host requires ZEROROUTER_ALLOW_REMOTE=true.
ZEROROUTER_HOST=127.0.0.1
ZEROROUTER_PORT=8787

# Required to bind a non-loopback host (management console reachable remotely).
ZEROROUTER_ALLOW_REMOTE=false

# Dashboard credential. Two options (documented in docs/security.md):
#   1. Preferred: provision the owner credential in the database with the CLI —
#      `npm -w packages/server run owner -- set-owner`
#      (username + scrypt-hashed password; rotation + session revocation built in).
#   2. Fallback: set this env password (password-only login; legacy deployments).
# If neither is set, the dashboard is limited to loopback clients.
ZEROROUTER_DASHBOARD_PASSWORD=

# Behind a TLS-terminating reverse proxy? Say so — trusted proxies provide the
# client address for login-throttling keys and the https proto that turns the
# session cookie `Secure`. NEVER enable without a real trusted proxy:
# the headers are client-forgeable otherwise.
ZEROROUTER_TRUST_PROXY=false

# ─ Secrets ─
# Master key for encrypting provider credentials at rest (base64, 32 bytes).
# Leave unset to auto-generate and persist ./data/.master_key (mode 0600).
# Set a stable base64 value if data/ is ephemeral or you move machines.
# ZEROROUTER_MASTER_KEY=

# ─ Storage ─
ZEROROUTER_DATA_DIR=./data

# Postgres storage backend (docs/postgres-migration.md). Unset → local SQLite
# file in the data dir. Use the Session pooler string (port 5432) on always-on
# hosts, the Transaction pooler (port 6543) for serverless targets.
# ZEROROUTER_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# – For Vercel production, use the Session pooler (5432) – the Transaction pooler
# (6543) hangs on Vercel network; the Session pooler works in both Vercel and
# always-on environments. Change the port to 6543 only if you need a dedicated
# serverless-only deployment that accepts the network limitations.

# ─ Web console (production) ─
# Path of the built dashboard. In NODE_ENV=production the default
# packages/web/dist is used automatically when it exists.
# ZEROROUTER_WEB_DIST=packages/web/dist

# Dev only: allow the Vite dev server origin to call the API cross-origin.
ZEROROUTER_DEV_CORS_ORIGIN=

# ─ Logging ─
# debug | info | warn | error
ZEROROUTER_LOG_LEVEL=info
